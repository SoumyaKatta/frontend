pipeline{
    agent any
    environment{
        PATH = "/usr/local/bin:$PATH"
        IMAGENAME = "soumyakatta/react-app"
        dockerPath = '/Applications/Docker.app/Contents/Resources/bin/docker'
        registryCredential = "docker-hub"
        dockerImage = ''
    }
    stages {
        stage("Install dependencies"){
            steps{      
                sh "npm install"
            }
        }
        stage("Building image") {
             steps{
                 script{
                   sh "docker build -t ${IMAGENAME} ."
                 }
             }
        }
  
        stage('CI') {
            steps {
               withCredentials([usernamePassword(
                credentialsId: registryCredential,
                passwordVariable: 'DOCKER_PASSWORD',
                usernameVariable: 'DOCKER_USERNAME'
            )]) {
                sh "docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}"
                sh "docker tag ${IMAGENAME} ${IMAGENAME}:${BUILD_NUMBER}"
                sh "docker push ${IMAGENAME}:${BUILD_NUMBER}"
                sh "docker push ${IMAGENAME}:latest"
            }
        }
    }
        stage('CD') {
            steps {
                sh "docker pull ${IMAGENAME}:latest"
                // sh "docker stop ${CONTAINER_NAME} || true"
                // sh "docker rm ${CONTAINER_NAME} || true"
                sh "docker run -d --name ${CONTAINER_NAME} ${IMAGENAME}:latest"
        }
    }

    }
}